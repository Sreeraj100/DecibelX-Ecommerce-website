<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
<script>
  $(document).ready(function() {
  // Initialize Owl Carousel for hero section
  $(".hero__slider").owlCarousel({
    items: 1,
    loop: true,
    autoplay: true,
    autoplayTimeout: 3000,
    autoplayHoverPause: true,
    smartSpeed: 1000,
    animateIn: 'fadeIn',
    animateOut: 'fadeOut',
    nav: true,
    margin: 0,
    dots: false,
    responsive: {
      0: {
        nav: false
      },
      768: {
        nav: true
      }
    }
  });


  // Category hover effects
  $('.category-item').hover(
    function() {
      $(this).find('.category-overlay').css('opacity', '1');
      $(this).find('.category-info').css('transform', 'translateY(0)');
    },
    function() {
      $(this).find('.category-overlay').css('opacity', '0');
      $(this).find('.category-info').css('transform', 'translateY(20px)');
    }
  );
});
</script>


