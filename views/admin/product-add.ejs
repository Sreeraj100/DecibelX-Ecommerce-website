<%- include("../../views/partials/admin/header") %>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.css">
    <style>
        .error-message {
            color: red;
            display: none;
        }

        .image-cropper {
            display: none;
            width: 100%;
            max-width: 400px;
            height: auto;
            min-height: 300px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            padding: 5px;
        }

        .image-cropper img {
            max-width: 100%;
            max-height: 100%;
            display: block;
        }

        /* Ensure cropper elements are visible */
        .cropper-container {
            z-index: 100;
        }
        
        .preview-container {
            margin-top: 10px;
            border: 1px solid #ddd;
            padding: 10px;
            display: none;
        }
        
        .preview-container img {
            max-width: 150px;
            max-height: 150px;
            display: block;
            margin: 0 auto;
        }

        /* Loading spinner */
        .spinner {
            display: none;
            margin-left: 10px;
            border: 3px solid rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            border-top: 3px solid #3498db;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .btn-container {
            display: flex;
            align-items: center;
        }
    </style>
</head>
<section class="content-main">
    <div class="row">
        <div class="col-9">
            <div class="content-header">
                <h2 class="content-title">Add New Product</h2>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-body">
                    <form method="post" action="/admin/addProducts" enctype="multipart/form-data" id="productForm">
                        <!-- Product Name -->
                        <div class="mb-4">
                            <label for="product_name" class="form-label">Product Name</label>
                            <input type="text" placeholder="Type here" name="productName" class="form-control border" id="product_name" required>
                            <div id="productName-error" class="error-message"></div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label class="form-label">Full Description</label>
                            <textarea placeholder="Type here" name="description" class="form-control border" rows="4" required></textarea>
                            <div id="description-error" class="error-message"></div>
                        </div>

                        <!-- Prices -->
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="mb-4">
                                    <label class="form-label">Regular Price</label>
                                    <input placeholder="$" name="regularPrice" type="number" class="form-control border" required>
                                    <div id="regularPrice-error" class="error-message"></div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="mb-4">
                                    <label class="form-label">Sale Price</label>
                                    <input placeholder="$" name="salePrice" type="number" class="form-control border">
                                    <div id="salePrice-error" class="error-message"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-4">
                            <label class="form-label">Category</label>
                            <select class="form-select border" name="category" required>
                                    <option value="" disabled selected>Select Category</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat._id %>"><%= cat.name %></option>
                                <% }) %>
                            </select>
                            <div id="category-error" class="error-message"></div>
                        </div>

                        <!-- Images -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h4>Product Images</h4>
                                <small class="text-muted">At least one image is required. Images will be cropped to a square.</small>
                            </div>
                            <div class="card-body">
                                <div id="images-error" class="error-message mb-3"></div>
                                <% for (let i = 1; i <= 4; i++) { %>
                                    <div class="mb-4">
                                        <label class="form-label">Image <%= i %></label>
                                        <div class="card-body align-items-center">
                                            <input class="form-control" type="file" name="images" id="input<%= i %>" accept="image/png, image/jpeg, image/jpg" onchange="viewImage(event, '<%= i %>')">
                                            <!-- Hidden input for cropped image data -->
                                            <input type="hidden" id="croppedInput<%= i %>" name="croppedImages">
                                        </div>
                                        <div class="image-cropper" id="cropperContainer<%= i %>">
                                            <img src="" id="imgView<%= i %>" alt="">
                                            <div class="d-flex mt-2">
                                                <button type="button" id="saveButton<%= i %>" class="btn btn-primary btn-sm me-2">Save Crop</button>
                                                <button type="button" id="cancelButton<%= i %>" class="btn btn-secondary btn-sm">Cancel</button>
                                            </div>
                                        </div>
                                        <div class="preview-container" id="previewContainer<%= i %>">
                                            <p>Cropped preview:</p>
                                            <img src="" id="croppedImg<%= i %>" alt="Cropped preview">
                                            <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="removeCroppedImage('<%= i %>')">Remove</button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="mt-4 btn-container">
                            <button class="btn btn-primary" type="submit" id="submitBtn">Add Product</button>
                            <div class="spinner" id="submitSpinner"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.js"></script>
<script>
    // Declare cropper variables for each image
    const croppers = {};
    const croppedImages = {};

    function viewImage(event, index) {
        const input = event.target;
        if (!input.files || !input.files[0]) return;
        
        const file = input.files[0];
        
        // Validate file type
        const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
        if (!validTypes.includes(file.type)) {
            alert('Please select a valid image file (JPEG, JPG, PNG)');
            input.value = '';
            return;
        }
        
        // Validate file size (max 5MB)
        if (file.size > 5 * 1024 * 1024) {
            alert('Image size must be less than 5MB');
            input.value = '';
            return;
        }
        
        const reader = new FileReader();

        reader.onload = function () {
            const dataURL = reader.result;
            const image = document.getElementById(`imgView${index}`);
            image.src = dataURL;
            
            // Show the image first, before initializing cropper
            image.style.display = "block";
            
            // Destroy existing Cropper instance (if any)
            if (croppers[index]) {
                croppers[index].destroy();
            }

            // Show Cropper Container
            const cropperContainer = document.getElementById(`cropperContainer${index}`);
            cropperContainer.style.display = "block";

            // Initialize Cropper after a slight delay to ensure image is rendered
            setTimeout(() => {
                croppers[index] = new Cropper(image, {
                    aspectRatio: 1, // Square crop
                    viewMode: 1,
                    guides: true,
                    background: false,
                    autoCropArea: 0.8,
                    zoomable: true,
                    responsive: true,
                    restore: false
                });
            }, 200);

            // Hide preview container when starting a new crop
            document.getElementById(`previewContainer${index}`).style.display = "none";
        };

        reader.readAsDataURL(file);

        // Set up cancel button
        document.getElementById(`cancelButton${index}`).onclick = function() {
            if (croppers[index]) {
                croppers[index].destroy();
                croppers[index] = null;
            }
            document.getElementById(`cropperContainer${index}`).style.display = "none";
            document.getElementById(`imgView${index}`).style.display = "none";
            // Don't clear the input file, as the user might want to try again
        };

        // Save Cropped Image
        document.getElementById(`saveButton${index}`).onclick = function () {
            if (!croppers[index]) return;
            
            const croppedCanvas = croppers[index].getCroppedCanvas({
                width: 440,
                height: 440,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high'
            });
            
            if (!croppedCanvas) {
                alert('Cropping failed. Please try again.');
                return;
            }
            
            // Show the cropped image preview
            const croppedImage = document.getElementById(`croppedImg${index}`);
            const croppedDataURL = croppedCanvas.toDataURL("image/jpeg", 0.9); // 90% quality JPEG
            croppedImage.src = croppedDataURL;
            document.getElementById(`previewContainer${index}`).style.display = "block";
            
            // Store the cropped image data in hidden input field
            document.getElementById(`croppedInput${index}`).value = croppedDataURL;
            
            // Store for form submission
            croppedImages[index] = croppedDataURL;
            
            // Hide Cropper Container
            document.getElementById(`cropperContainer${index}`).style.display = "none";
            
            // Reset error message if present
            document.getElementById("images-error").style.display = "none";
        };
    }

    // Remove cropped image
    function removeCroppedImage(index) {
        // Clear the cropped image
        document.getElementById(`croppedInput${index}`).value = "";
        document.getElementById(`previewContainer${index}`).style.display = "none";
        
        // Clear the file input to allow selecting a new file
        document.getElementById(`input${index}`).value = "";
        
        // Delete from our storage
        if (croppedImages[index]) {
            delete croppedImages[index];
        }
    }

    // Convert Data URL to Blob
    function dataURLtoBlob(dataURL) {
        const parts = dataURL.split(';base64,');
        const contentType = parts[0].split(':')[1];
        const raw = window.atob(parts[1]);
        const uInt8Array = new Uint8Array(raw.length);
        
        for (let i = 0; i < raw.length; ++i) {
            uInt8Array[i] = raw.charCodeAt(i);
        }
        
        return new Blob([uInt8Array], { type: contentType });
    }

    // Form Validation
    function validateForm() {
        let isValid = true;
        let errorMessages = {};
        
        // Get form values
        const productName = document.getElementById("product_name").value.trim();
        const description = document.querySelector("textarea[name='description']").value.trim();
        const regularPrice = document.querySelector("input[name='regularPrice']").value.trim();
        const salePrice = document.querySelector("input[name='salePrice']").value.trim();
        const category = document.querySelector("select[name='category']").value.trim();
        
        // Reset error messages
        document.querySelectorAll(".error-message").forEach(el => {
            el.textContent = "";
            el.style.display = "none";
        });

        // Product Name validation
        if (!productName) {
            errorMessages.productName = "Product name is required";
        } else if (productName.length < 3) {
            errorMessages.productName = "Product name must be at least 3 characters";
        } else if (productName.length > 100) {
            errorMessages.productName = "Product name must be less than 100 characters";
        }

        // Description validation
        if (!description) {
            errorMessages.description = "Description is required";
        } else if (description.length < 10) {
            errorMessages.description = "Description must be at least 10 characters";
        }

        // Regular Price validation
        if (!regularPrice) {
            errorMessages.regularPrice = "Regular price is required";
        } else if (isNaN(regularPrice) || parseFloat(regularPrice) <= 0) {
            errorMessages.regularPrice = "Regular price must be a positive number";
        }

        // Sale Price validation (if provided)
        if (salePrice) {
            if (isNaN(salePrice) || parseFloat(salePrice) <= 0) {
                errorMessages.salePrice = "Sale price must be a positive number";
            } else if (parseFloat(salePrice) >= parseFloat(regularPrice)) {
                errorMessages.salePrice = "Sale price must be less than regular price";
            }
        }

        // Category validation
        if (!category) {
            errorMessages.category = "Category is required";
        }

        // Image validation
        let hasImages = false;
        for (let i = 1; i <= 4; i++) {
            if (document.getElementById(`croppedInput${i}`).value) {
                hasImages = true;
                break;
            }
        }
        
        // if (!hasImages) {
        //     errorMessages.images = "At least one cropped image is required";
        // }

        // Display error messages if any
        for (const [field, message] of Object.entries(errorMessages)) {
            const errorElement = document.getElementById(`${field}-error`);
            if (errorElement) {
                errorElement.textContent = message;
                errorElement.style.display = "block";
                isValid = false;
            }
        }

        return isValid;
    }

    // Handle form submission
    document.getElementById("productForm").addEventListener("submit", function(e) {
        e.preventDefault();
        
        if (!validateForm()) {
            return false;
        }
        
        // Show loading spinner
        const submitBtn = document.getElementById("submitBtn");
        const spinner = document.getElementById("submitSpinner");
        submitBtn.disabled = true;
        spinner.style.display = "inline-block";
        
        const formData = new FormData(this);
        
        // Process cropped images
        for (let i = 1; i <= 4; i++) {
            const croppedDataUrl = document.getElementById(`croppedInput${i}`).value;
            if (croppedDataUrl) {
                // Convert data URL to Blob
                const blob = dataURLtoBlob(croppedDataUrl);
                formData.append(`croppedImage${i}`, blob, `image${i}.jpg`);
            }
        }
        
        // Remove the file inputs since we're using the cropped data
        formData.delete('images');
        
        fetch(this.action, {
            method: "POST",
            body: formData
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`Server responded with ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                alert(data.message);
                window.location.href = "/admin/products"; // Redirect to products page
            } else {
                alert(data.message || "Error adding product");
                submitBtn.disabled = false;
                spinner.style.display = "none";
            }
        })
        .catch((error) => {
            console.error("Error:", error);
            alert("An error occurred. Please try again.");
            submitBtn.disabled = false;
            spinner.style.display = "none";
        });
        
        return false;
    });
</script>
<%- include("../../views/partials/admin/footer") %>